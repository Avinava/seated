{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm exec tsx tools/serve-static.ts dist/seated/browser 4600",
      "startServerReadyPattern": "Serving .* at http",
      "startServerReadyTimeout": 30000,
      "url": ["http://127.0.0.1:4600/", "http://127.0.0.1:4600/brand", "http://127.0.0.1:4600/s"],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 235520 }],
        "resource-summary:font:size": ["error", { "maxNumericValue": 153600 }],
        "resource-summary:total:size": ["error", { "maxNumericValue": 430080 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
