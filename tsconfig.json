{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "paths": {
      "@seated/domain": ["./libs/domain/src/index.ts"],
      "@seated/domain/*": ["./libs/domain/src/*/index.ts"],
      "@seated/kit": ["./libs/kit/src/public-api.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true,
    "strictStandalone": true
  },
  "files": [],
  "references": [
    { "path": "./libs/domain/tsconfig.json" },
    { "path": "./apps/seated/tsconfig.app.json" },
    { "path": "./apps/seated/tsconfig.spec.json" },
    { "path": "./libs/kit/tsconfig.lib.json" },
    { "path": "./libs/kit/tsconfig.spec.json" }
  ]
}
