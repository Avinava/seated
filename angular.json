{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm",
    "analytics": false
  },
  "newProjectRoot": "apps",
  "projects": {
    "seated": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "changeDetection": "OnPush"
        }
      },
      "root": "apps/seated",
      "sourceRoot": "apps/seated/src",
      "prefix": "st",
      "i18n": {
        "sourceLocale": "en-IN"
      },
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "apps/seated/src/main.ts",
            "tsConfig": "apps/seated/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "polyfills": ["@angular/localize/init"],
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/seated/public"
              }
            ],
            "styles": [
              "node_modules/@fontsource-variable/bricolage-grotesque/opsz.css",
              "node_modules/@fontsource-variable/geist/wght.css",
              "node_modules/@fontsource-variable/geist-mono/wght.css",
              "libs/kit/src/styles/index.scss",
              "apps/seated/src/styles.scss"
            ],
            "server": "apps/seated/src/main.server.ts",
            "outputMode": "static"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "480kB",
                  "maximumError": "550kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kB",
                  "maximumError": "10kB"
                }
              ],
              "outputHashing": "all",
              "serviceWorker": "apps/seated/ngsw-config.json"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "seated:build:production"
            },
            "development": {
              "buildTarget": "seated:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "apps/seated/tsconfig.spec.json"
          }
        }
      }
    },
    "kit": {
      "projectType": "library",
      "root": "libs/kit",
      "sourceRoot": "libs/kit/src",
      "prefix": "st",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "changeDetection": "OnPush"
        }
      },
      "architect": {
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "seated:build:development",
            "tsConfig": "libs/kit/tsconfig.spec.json"
          }
        },
        "storybook": {
          "builder": "@storybook/angular-vite:start-storybook",
          "options": {
            "configDir": "libs/kit/.storybook",
            "tsConfig": "libs/kit/.storybook/tsconfig.json",
            "port": 6006,
            "zoneless": true,
            "styles": [
              "node_modules/@fontsource-variable/bricolage-grotesque/opsz.css",
              "node_modules/@fontsource-variable/geist/wght.css",
              "node_modules/@fontsource-variable/geist-mono/wght.css",
              "libs/kit/src/styles/index.scss",
              "libs/kit/.storybook/preview.scss"
            ]
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular-vite:build-storybook",
          "options": {
            "configDir": "libs/kit/.storybook",
            "tsConfig": "libs/kit/.storybook/tsconfig.json",
            "outputDir": "storybook-static",
            "zoneless": true,
            "styles": [
              "node_modules/@fontsource-variable/bricolage-grotesque/opsz.css",
              "node_modules/@fontsource-variable/geist/wght.css",
              "node_modules/@fontsource-variable/geist-mono/wght.css",
              "libs/kit/src/styles/index.scss",
              "libs/kit/.storybook/preview.scss"
            ]
          }
        }
      }
    }
  }
}
